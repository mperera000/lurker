# Postgres (Neon, Supabase, or local docker compose)
DATABASE_URL=postgres://watcher:watcher@localhost:5432/launch_watcher

# Required by POST /api/cron/ingest
CRON_SECRET=change-me-to-a-long-random-string

# Optional. When missing, ingest returns { mode: "mock", ingested: 0 }
X_BEARER_TOKEN=

# Public app URL (used in emails / Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js — leave unset for open local dashboard (v1 single-user)
# AUTH_SECRET=
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me
# Optional magic link
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Launch Watcher <noreply@example.com>
