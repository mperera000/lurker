# Postgres (Neon, Supabase, or local docker compose)
DATABASE_URL=postgres://watcher:watcher@localhost:5432/launch_watcher

# Required by POST /api/cron/ingest
CRON_SECRET=change-me-to-a-long-random-string

# Optional. When missing, ingest returns { mode: "mock", ingested: 0 }
X_BEARER_TOKEN=

# Phase 0 / live ingest via Grok X Search (https://x.ai/api)
# XAI_API_KEY=

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email login (Auth.js). Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
